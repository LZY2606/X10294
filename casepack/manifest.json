  "mutations": [
    {
      "id": "M1-bit-order-reversal",
      "kind": "reverse32",
      "target_word": "w-001",
      "changes": "raw32",
      "label": "位序反转 (bit order reversal)",
      "expected_scope": [
        "decoded:w-001",
        "aggregate:ch-A/203"
      ]
    },
    {
      "id": "M2-parity-error",
      "kind": "flipParity",
      "target_word": "w-013",
      "changes": "parity bit",
      "label": "奇偶错误 (bad parity)",
      "expected_scope": [
        "decoded:w-013",
        "aggregate:ch-A/206"
      ]
    },
    {
      "id": "M3-octal-label-presentation",
      "kind": "octalPresentation",
      "target_word": "w-013",
      "changes": "presentation only",
      "label": "八进制 label 展示 (octal label presentation)",
      "expected_scope": [],
      "note": "displaying label as octal never mutates the underlying 32 bits"
    },
    {
      "id": "M4-bnr-negative",
      "kind": "sourceEdit",
      "target_word": "w-019",
      "raw_text": "0x1FF31CC1",
      "changes": "BNR data field sign",
      "label": "BNR 负值 (negative BNR)",
      "expected_scope": [
        "decoded:w-019",
        "aggregate:ch-A/203"
      ]
    },
    {
      "id": "M5-bcd-illegal-digit",
      "kind": "sourceEdit",
      "target_word": "w-023",
      "raw_text": "0x80127061",
      "changes": "BCD low nibble -> 0xC",
      "label": "BCD 非法数字 (illegal BCD digit)",
      "expected_scope": [
        "decoded:w-023",
        "aggregate:ch-A/206"
      ]
    },
    {
      "id": "M6-rate-switch",
      "kind": "sourceEdit",
      "target_word": "w-019",
      "receive_time_us": "544160",
      "changes": "receive timestamp aligns with the 100 kbps cadence",
      "label": "速率切换 (rate switch timing)",
      "expected_scope": [
        "rate:ch-A"
      ]
    },
    {
      "id": "M7-ssm-invalid",
      "kind": "sourceEdit",
      "target_word": "w-021",
      "raw_text": "0xB023F0C1",
      "changes": "SSM -> FW",
      "label": "SSM 无效状态 (SSM failure warning)",
      "expected_scope": [
        "decoded:w-021",
        "aggregate:ch-A/203"
      ]
    }
  ],
  "replay_stages": [
    {
      "stage": 1,
      "name": "baseline-import",
      "title": "导入基线并核对原位字段",
      "action": {
        "type": "import-casepack"
      },
      "assertions": [
        "raw words preserve orig_index/receive_time_us/channel/raw_text",
        "parity, label octal, SDI, SSM, data and dictionary version visible"
      ]
    },
    {
      "stage": 2,
      "name": "parameter-revision",
      "title": "规则参数修订 (rules-1.0 -> rules-2.0)",
      "action": {
        "type": "use-rule",
        "version": "rules-2.0"
      },
      "assertions": [
        "only rate analyses invalidate; decoded words untouched"
      ]
    },
    {
      "stage": 3,
      "name": "local-source-edit",
      "title": "只影响局部依赖的源数据改动",
      "action": {
        "type": "material-version",
        "change": "flip parity of w-007",
        "target_word": "w-007"
      },
      "assertions": [
        "only decoded:w-007 and aggregate:ch-A/203 are invalidated",
        "rate and other labels keep their conclusions"
      ]
    },
    {
      "stage": 4,
      "name": "conflicting-decisions",
      "title": "互相冲突的人工决定",
      "action": {
        "type": "conflict",
        "object": "rate:ch-A",
        "candidates": [
          "12500",
          "100000"
        ]
      },
      "assertions": [
        "second submit sees conflict and both diffs",
        "undo restores the previous branch state"
      ]
    }
  ],
  "expectations": {
    "channels": [
      "ch-A",
      "ch-B"
    ],
    "ch_a_segment_rates_bps": [
      12500,
      100000
    ],
    "acquisition_gap_min_us": 20000,
    "baseline_counts": {
      "words": 24,
      "bad_parity": 1,
      "illegal_bcd": 1,
      "negative_bnr": 2,
      "ssm_invalid_bnr": 1
    }
  }
}