{
  "id": "arinc429-word-decoding-bench",
  "title": "字路译码台：ARINC 429 标签、奇偶与速率分段证据",
  "domain": "ARINC 429",
  "casepack_version": "1.0.0",
  "narrative": [
    "航电数据小组导入时间戳与32位原始字、通道配置和标签字典；",
    "审阅字序、速率分段和工程值解释，所有结论保留来源链。"
  ],
  "rules": [
    "label 的八进制展示不改变底层位",
    "BNR/BCD/discrete 解释由字典版本决定",
    "速率变化与采集缺口保留分段候选",
    "坏奇偶字不进入聚合值",
    "无法唯一决定时保留全部合法候选"
  ],
